generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  firstName     String?
  lastName      String?
  role                 String         @default("user")
  canAccessAllHouses   Boolean        @default(false)
  profileImage         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  invitesSent   Invite[]       @relation("InvitesSent")
  houseMembers  HouseMember[]
  dutyShifts     DutyShift[]
  roomDutyShifts RoomDutyShift[]
}

/// Dežurstva za izdavanje soba (Aristotelis / Sartios / Ostraco) — više smena po danu i liniji, vreme 09:00–15:00.
model RoomDutyShift {
  id        String   @id @default(cuid())
  date      String
  slotKey   String
  startTime String
  endTime   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([date, slotKey])
}

model DutyShift {
  id          String   @id @default(cuid())
  date        String
  startTime   String
  endTime     String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([userId, date])
}

model Invite {
  id         String    @id @default(cuid())
  email      String
  role       String    @default("user")
  token      String    @unique
  invitedBy  String
  inviter    User      @relation("InvitesSent", fields: [invitedBy], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

model HouseMember {
  id        String   @id @default(cuid())
  houseId   String
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([houseId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  severity  String   @default("normal")
  taskId    String?
  title     String
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model House {
  id                String   @id @default(cuid())
  name              String
  address           String?
  totalRooms        Int?
  totalCapacity     Int?
  responsiblePerson String?
  location          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  rooms             Room[]
  members           HouseMember[]
}

model Room {
  id                 String    @id @default(cuid())
  houseId            String
  house              House     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseName          String?
  roomNumber         String
  roomStructure      String?
  capacity           Int?
  currentOccupants   Int?
  occupantNames      String    @default("[]")
  notes              String?
  notesUpdatedAt     DateTime?
  excursion          String?
  excursionUpdatedAt DateTime?
  visit              String?
  visitUpdatedAt     DateTime?
  stayFrom           String?
  stayTo             String?
  contactPhone       String?
  contractNumber     String?
  bus                Boolean   @default(false)
  taxPaid            Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Column {
  id        String   @id @default(cuid())
  name      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id             String   @id @default(cuid())
  title          String
  description    String?
  columnId       String
  column         Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  order          Int
  startDate      String?
  dueDate        String?
  labels         String   @default("[]")
  assignedUsers  String   @default("[]")
  images         String   @default("[]")
  cardColor      String?
  epicTitle      String?
  checklists     String   @default("[]")
  comments       String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Excursion {
  id        String   @id @default(cuid())
  name      String   @unique
  adlPrice  Float
  chdPrice  Float?
  icon      String   @default("boat")
  theme     String   @default("cyan")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InfoFolder {
  id        String       @id @default(cuid())
  name      String
  color     String?
  parentId  String?
  parent    InfoFolder?  @relation("InfoFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  InfoFolder[] @relation("InfoFolderTree")
  files     InfoFile[]
  createdBy String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model InfoFile {
  id         String     @id @default(cuid())
  folderId   String
  folder     InfoFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name       String
  storedPath String
  mimeType   String?
  sizeBytes  Int        @default(0)
  uploadedBy String?
  createdAt  DateTime   @default(now())
}
